# 发布版本。普通用户通常不需要修改。
APP_VERSION=v0.1.0

# 可选：改用自建镜像仓库时填写完整镜像名。
# BACKEND_IMAGE=ghcr.io/leaarningandthinking/huashan-stock-analysis/backend
# FRONTEND_IMAGE=ghcr.io/leaarningandthinking/huashan-stock-analysis/frontend

# 数据库（仅用于容器内连接和初始化）
DB_NAME=huashan
DB_USER=huashan
DB_PASSWORD=change-me-db-password

# 后端安全配置。运行 scripts/install.sh 会自动生成随机值。
SESSION_SECRET=change-me-session-secret
AUTH_SECRET=change-me-auth-secret
PASSWORD_HASH_PEPPER=change-me-password-pepper
ANON_COOKIE_NAME=hs_anon
AUTH_COOKIE_NAME=hs_session
AUTH_COOKIE_SECURE=false

# 后端行为
APP_ENV=production
AUTO_CREATE_TABLES=false
SKILL_DIR=/app/skills/huashan-lungu-v2
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_DAY=20

# 前端端口
FRONTEND_PORT=3000
